{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loops",
  "version": "0.5.0",
  "identifier": "com.fabiantax.loops",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3001",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Loops",
        "width": 1100,
        "height": 820,
        "minWidth": 880,
        "minHeight": 640,
        "backgroundColor": "#0a0b0b",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBMzIyM0JBM0QxODFFRApSV1R0Z2RHak95S2pBVlN5Lzd6U3o3N2NzeDh5LzI0VFFKT05zWDhKckU2dlZEVXZ2bDBUbXVNZwo=",
      "endpoints": [
        "https://github.com/fabiantax87/loops/releases/latest/download/latest.json"
      ]
    }
  }
}
